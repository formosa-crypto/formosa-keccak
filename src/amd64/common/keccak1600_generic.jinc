/*
 FEATURE SPECIFICATION
 =====================
*/

// Feature selection
//  to be feeded into "KECCAK_FEATURES"
param int KECCAK_FEATURE_BMI  = 0x01; // (BMI1)
param int KECCAK_FEATURE_BMI2 = 0x02;
param int KECCAK_FEATURE_AVX2 = 0x04;

// FEATURE QUERY
inline fn __HAS_FEATURE
( inline int SELECTION FEATURES
) -> inline bool
{
  inline bool b;
  b = (FEATURES & SELECTION)!= 0;
  return b;
}

// STANDARD RATES
param int R72 = 72;
param int R104 = 104;
param int R136 = 136;
param int R144 = 144;
param int R168 = 168;

// STANDARD TRAIL BYTES
param int UNFINISHED = 0;
param int SHA3 = 0x06;
param int RAWSHAKE = 0x07;
param int SHAKE = 0x1F;

type keccak_state = u64[25];


/* UTILITY FUNCTIONS */

inline fn __SHLQ
( reg u64 x
, inline int shbytes
) -> reg u64
{
  if (shbytes != 0) {
    x <<= (8*shbytes);
  }
  return x;
}

inline fn __SHLDQ
( reg u128 x
, inline int shbytes
) -> reg u128
{
  if (shbytes != 0) {
    x = #VPSLLDQ_128(x, shbytes);
  }
  return x;
}

inline fn __SHLQ_256
( reg u256 x
, inline int shbytes
) -> reg u256
{
  if (shbytes != 0) {
    x = #VPSLL_4u64(x, 8*shbytes);
  }
  return x;
}
