from Keccak require "common/keccak1600_default.jinc"

/* it makes no sense to redefine default KECCAK_FEATURES, as
 the opt permutation always assume all features (AVX2+BMI+BMI2).
*/

from Keccak require "ref/keccakf1600_opt.jinc"

export fn keccakf1600_opt
( reg mut ptr u64[25] st
) -> reg ptr u64[25]
{
 st = _keccakf1600_opt(st);
 return st;
}
