from Keccak require "common/keccak1600_default.jinc"

/*
// Possibly, refining some defaults (jasminc will emit a warning!)
param int KECCAK_FEATURES
 = KECCAK_FEATURE_BMI;
param int KECCAK_PERMUTATION = KECCAK_F1600_REF + KECCAK_F1600x4_REF;
