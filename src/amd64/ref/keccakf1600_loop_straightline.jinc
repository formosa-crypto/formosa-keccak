/****************************************************************************

   Keccak-f1600 -- direct Jasmin transcription of the *loop body* of
   KeccakF1600_StatePermute from `bench/permutations/fips202.s` (clang -O3 of
   the XKCP "optimized C", two rounds unrolled with an A->E / E->A ping-pong).

   This is a straight, line-by-line transliteration of asm lines 74-444 (one
   loop iteration), produced mechanically:

     * x86 GP registers  ->  reg u64 variables named after the register
                             (rax, rbx, ..., r15).  These are plain Jasmin
                             names, NOT pinned to hardware registers.
     * `movq`            ->  assignment;   `xorq a,b`  ->  `b ^= a`.
     * `rorxq $n,s,d`    ->  `d = #RORX_64(s, n);`
     * `andnq A,B,C`(AT&T)-> `C = !B & A;`  (i.e. C = (~B) & A)
     * round constants   ->  the global `KECCAK1600_RC` table, rematerialized
                             before each of the two iota uses (a local reg ptr
                             `RC`, mirroring clang's `leaq ...(%rip)` per use --
                             NOT a passed-in pointer argument).

   STACK-SLOT MIRROR (literal: each %rsp offset is a fixed array cell, named the
   same regardless of whether it currently holds an A- or an E-value):

     a[] : the 16 memory-resident state lanes (offset -> lane index, fixed by
           the function prologue / epilogue):
             (%rsp)=a[8]   8=a[2]    -8=a[4]    -16=a[1]   -40=a[3]   -48=a[5]
             -56=a[14] -64=a[11] -72=a[15] -80=a[23] -88=a[6] -96=a[7]
             -104=a[13] -112=a[17] -120=a[9] -128=a[16]
     e[] : the 11 scratch slots clang allocated (write-first, dead at iteration
           end -> local stack):
             -32=e[0] -24=e[1] 16=e[2] 24=e[3] 32=e[4] 40=e[5]
             48=e[6] 56=e[7] 64=e[8] 80=e[9] 88=e[10]
           (e[3] = 24(%rsp) is the round-counter spill slot.)

   The 9 lanes clang keeps in GP registers across iterations, plus the round
   counter (rax), are loop-carried -> they are the function arguments AND
   results:
             rbp=a[0]  rdi=a[10] r13=a[12] r10=a[18] r11=a[19]
             r8=a[20]  rsi=a[21] r15=a[22] rbx=a[24]   rax=counter c
   They get clobbered/reused as scratch mid-body and hold their NEW lane value
   by the end of the body -- a straight transliteration reproduces this.

   DEPENDENCIES (provided by the including context, as in keccakf1600_ref_opt2):
     __ANDN_64 from the selected "ref/select_{bmi1,nobmi1}.jinc";
     #RORX_64 is a BMI2 intrinsic;
     KECCAK1600_RC from "common/keccakf1600_generic.jinc" (required below).

   NOTE: not tested for functional correctness (per request); a single loop
   iteration only -- the surrounding while/branch is left as comments.

*****************************************************************************/

from Keccak require "common/keccakf1600_generic.jinc"   // KECCAK1600_RC

inline fn keccakf1600_loop_body
( reg u64 rax                                   // round counter c
, reg u64 rbp                                   // a[0]
, reg u64 rdi                                   // a[10]
, reg u64 r13                                   // a[12]
, reg u64 r10                                   // a[18]
, reg u64 r11                                   // a[19]
, reg u64 r8                                    // a[20]
, reg u64 rsi                                   // a[21]
, reg u64 r15                                   // a[22]
, reg u64 rbx                                   // a[24]
, reg mut ptr u64[25] a
, stack u64[25] e
) -> reg u64, reg u64, reg u64, reg u64, reg u64
   , reg u64, reg u64, reg u64, reg u64, reg u64
   , reg ptr u64[25]
   , stack u64[25]
{
  reg u64 rcx rdx r9 r12 r14;
  reg ptr u64[24] RC;

  // .LBB0_1:                                   # =>This Inner Loop Header: Depth=1
  e[0] = r11;                                   // movq %r11, -32(%rsp)
  e[1] = rdi;                                   // movq %rdi, -24(%rsp)
  e[3] = rax;                                   // movq %rax, 24(%rsp)   (counter spill)
  e[2] = rsi;                                   // movq %rsi, 16(%rsp)
  rcx = a[15];                                  // movq -72(%rsp), %rcx
  rcx ^= r8;                                    // xorq %r8, %rcx
  rax = rdi;                                    // movq %rdi, %rax
  rax ^= a[5];                                  // xorq -48(%rsp), %rax
  rax ^= rcx;                                   // xorq %rcx, %rax
  rdx = a[16];                                  // movq -128(%rsp), %rdx
  rdx ^= rsi;                                   // xorq %rsi, %rdx
  rcx = a[11];                                  // movq -64(%rsp), %rcx
  rsi = a[6];                                   // movq -88(%rsp), %rsi
  rcx ^= rsi;                                   // xorq %rsi, %rcx
  rcx ^= rdx;                                   // xorq %rdx, %rcx
  rdx = a[17];                                  // movq -112(%rsp), %rdx
  rdx ^= r15;                                   // xorq %r15, %rdx
  r9 = r13;                                     // movq %r13, %r9
  r9 ^= a[7];                                   // xorq -96(%rsp), %r9
  r9 ^= rdx;                                    // xorq %rdx, %r9
  rdx = r10;                                    // movq %r10, %rdx
  rdx ^= a[23];                                 // xorq -80(%rsp), %rdx
  r12 = a[13];                                  // movq -104(%rsp), %r12
  r12 ^= a[8];                                  // xorq (%rsp), %r12
  r12 ^= rdx;                                   // xorq %rdx, %r12
  rdx = r11;                                    // movq %r11, %rdx
  rdx ^= rbx;                                   // xorq %rbx, %rdx
  r14 = a[14];                                  // movq -56(%rsp), %r14
  r14 ^= a[9];                                  // xorq -120(%rsp), %r14
  r14 ^= rdx;                                   // xorq %rdx, %r14
  rax ^= rbp;                                   // xorq %rbp, %rax
  rcx ^= a[1];                                  // xorq -16(%rsp), %rcx
  r9 ^= a[2];                                   // xorq 8(%rsp), %r9
  rdi = a[3];                                   // movq -40(%rsp), %rdi
  r12 ^= rdi;                                   // xorq %rdi, %r12
  r14 ^= a[4];                                  // xorq -8(%rsp), %r14
  rdx = #RORX_64(r12, 63);                      // rorxq $63, %r12, %rdx
  rdx ^= rcx;                                   // xorq %rcx, %rdx
  e[10] = rdx;                                  // movq %rdx, 88(%rsp)
  r11 = #RORX_64(rcx, 63);                      // rorxq $63, %rcx, %r11
  r11 ^= r14;                                   // xorq %r14, %r11
  e[9] = r11;                                   // movq %r11, 80(%rsp)
  rcx = #RORX_64(r14, 63);                      // rorxq $63, %r14, %rcx
  rcx ^= r9;                                    // xorq %r9, %rcx
  r9 = #RORX_64(r9, 63);                        // rorxq $63, %r9, %r9
  r9 ^= rax;                                    // xorq %rax, %r9
  rax = #RORX_64(rax, 63);                      // rorxq $63, %rax, %rax
  rax ^= r12;                                   // xorq %r12, %rax
  rbp ^= r11;                                   // xorq %r11, %rbp
  rsi ^= r9;                                    // xorq %r9, %rsi
  r11 = r9;                                     // movq %r9, %r11
  r9 = #RORX_64(rsi, 20);                       // rorxq $20, %rsi, %r9
  r13 ^= rdx;                                   // xorq %rdx, %r13
  r14 = #RORX_64(r13, 21);                      // rorxq $21, %r13, %r14
  r10 ^= rcx;                                   // xorq %rcx, %r10
  r10 = #RORX_64(r10, 43);                      // rorxq $43, %r10, %r10
  rbx ^= rax;                                   // xorq %rax, %rbx
  rbx = #RORX_64(rbx, 50);                      // rorxq $50, %rbx, %rbx
  rsi = !rbx & rbp;                             // andnq %rbp, %rbx, %rsi
  rsi ^= r10;                                   // xorq %r10, %rsi
  a[6] = rsi;                                   // movq %rsi, -88(%rsp)
  rsi = !r14 & r10;                             // andnq %r10, %r14, %rsi
  r10 = !r10 & rbx;                             // andnq %rbx, %r10, %r10
  r10 ^= r14;                                   // xorq %r14, %r10
  e[8] = r10;                                   // movq %r10, 64(%rsp)
  r12 = !r9 & r14;                              // andnq %r14, %r9, %r12
  RC = KECCAK1600_RC;                            // leaq KeccakF_RoundConstants(%rip), %r10
  r14 = e[3];                                   // movq 24(%rsp), %r14   (counter reload)
  r12 ^= RC[(int) r14 + 2];                      // xorq 16(%r10,%r14,8), %r12
  r12 ^= rbp;                                   // xorq %rbp, %r12
  rsi ^= r9;                                    // xorq %r9, %rsi
  e[6] = rsi;                                   // movq %rsi, 48(%rsp)
  r9 = !rbp & r9;                               // andnq %r9, %rbp, %r9
  r9 ^= rbx;                                    // xorq %rbx, %r9
  e[7] = r9;                                    // movq %r9, 56(%rsp)
  rdi ^= rcx;                                   // xorq %rcx, %rdi
  rdx = rcx;                                    // movq %rcx, %rdx
  r9 = #RORX_64(rdi, 36);                       // rorxq $36, %rdi, %r9
  rsi = a[9];                                   // movq -120(%rsp), %rsi
  rsi ^= rax;                                   // xorq %rax, %rsi
  r10 = #RORX_64(rsi, 44);                      // rorxq $44, %rsi, %r10
  rsi = e[1];                                   // movq -24(%rsp), %rsi
  r13 = e[9];                                   // movq 80(%rsp), %r13
  rsi ^= r13;                                   // xorq %r13, %rsi
  rsi = #RORX_64(rsi, 61);                      // rorxq $61, %rsi, %rsi
  rdi = a[16];                                  // movq -128(%rsp), %rdi
  rcx = r11;                                    // movq %r11, %rcx
  rdi ^= r11;                                   // xorq %r11, %rdi
  rdi = #RORX_64(rdi, 19);                      // rorxq $19, %rdi, %rdi
  rbp = e[10];                                  // movq 88(%rsp), %rbp
  r15 ^= rbp;                                   // xorq %rbp, %r15
  rbx = #RORX_64(r15, 3);                       // rorxq $3, %r15, %rbx
  r15 = !rbx & r9;                              // andnq %r9, %rbx, %r15
  r15 ^= rdi;                                   // xorq %rdi, %r15
  e[1] = r15;                                   // movq %r15, -24(%rsp)
  r15 = !rsi & rdi;                             // andnq %rdi, %rsi, %r15
  rdi = !rdi & rbx;                             // andnq %rbx, %rdi, %rdi
  rdi ^= rsi;                                   // xorq %rsi, %rdi
  e[5] = rdi;                                   // movq %rdi, 40(%rsp)
  rsi = !r10 & rsi;                             // andnq %rsi, %r10, %rsi
  rsi ^= r9;                                    // xorq %r9, %rsi
  a[16] = rsi;                                  // movq %rsi, -128(%rsp)
  r15 ^= r10;                                   // xorq %r10, %r15
  a[3] = r15;                                   // movq %r15, -40(%rsp)
  rsi = !r9 & r10;                              // andnq %r10, %r9, %rsi
  rsi ^= rbx;                                   // xorq %rbx, %rsi
  a[9] = rsi;                                   // movq %rsi, -120(%rsp)
  rsi = a[1];                                   // movq -16(%rsp), %rsi
  rsi ^= r11;                                   // xorq %r11, %rsi
  rsi = #RORX_64(rsi, 63);                      // rorxq $63, %rsi, %rsi
  rdi = a[7];                                   // movq -96(%rsp), %rdi
  rdi ^= rbp;                                   // xorq %rbp, %rdi
  rdi = #RORX_64(rdi, 58);                      // rorxq $58, %rdi, %rdi
  r9 = a[13];                                   // movq -104(%rsp), %r9
  r9 ^= rdx;                                    // xorq %rdx, %r9
  r9 = #RORX_64(r9, 39);                        // rorxq $39, %r9, %r9
  r10 = e[0];                                   // movq -32(%rsp), %r10
  r10 ^= rax;                                   // xorq %rax, %r10
  r10 = #RORX_64(r10, 56);                      // rorxq $56, %r10, %r10
  r14 = r13;                                    // movq %r13, %r14
  r8 ^= r13;                                    // xorq %r13, %r8
  r8 = #RORX_64(r8, 46);                        // rorxq $46, %r8, %r8
  r11 = !r8 & rsi;                              // andnq %rsi, %r8, %r11
  r11 ^= r10;                                   // xorq %r10, %r11
  a[13] = r11;                                  // movq %r11, -104(%rsp)
  r11 = !r9 & r10;                              // andnq %r10, %r9, %r11
  r13 = !r10 & r8;                              // andnq %r8, %r10, %r13
  r13 ^= r9;                                    // xorq %r9, %r13
  r9 = !rdi & r9;                               // andnq %r9, %rdi, %r9
  r9 ^= rsi;                                    // xorq %rsi, %r9
  a[7] = r9;                                    // movq %r9, -96(%rsp)
  r11 ^= rdi;                                   // xorq %rdi, %r11
  e[4] = r11;                                   // movq %r11, 32(%rsp)
  rsi = !rsi & rdi;                             // andnq %rdi, %rsi, %rsi
  rsi ^= r8;                                    // xorq %r8, %rsi
  e[0] = rsi;                                   // movq %rsi, -32(%rsp)
  rsi = a[4];                                   // movq -8(%rsp), %rsi
  rsi ^= rax;                                   // xorq %rax, %rsi
  rsi = #RORX_64(rsi, 37);                      // rorxq $37, %rsi, %rsi
  rdi = a[5];                                   // movq -48(%rsp), %rdi
  rdi ^= r14;                                   // xorq %r14, %rdi
  rdi = #RORX_64(rdi, 28);                      // rorxq $28, %rdi, %rdi
  r8 = a[11];                                   // movq -64(%rsp), %r8
  r8 ^= rcx;                                    // xorq %rcx, %r8
  r8 = #RORX_64(r8, 54);                        // rorxq $54, %r8, %r8
  r9 = a[17];                                   // movq -112(%rsp), %r9
  r9 ^= rbp;                                    // xorq %rbp, %r9
  r11 = #RORX_64(r9, 49);                       // rorxq $49, %r9, %r11
  r9 = a[23];                                   // movq -80(%rsp), %r9
  r9 ^= rdx;                                    // xorq %rdx, %r9
  rbx = #RORX_64(r9, 8);                        // rorxq $8, %r9, %rbx
  r10 = !rbx & rsi;                             // andnq %rsi, %rbx, %r10
  r10 ^= r11;                                   // xorq %r11, %r10
  r15 = !r8 & r11;                              // andnq %r11, %r8, %r15
  r11 = !r11 & rbx;                             // andnq %rbx, %r11, %r11
  r11 ^= r8;                                    // xorq %r8, %r11
  a[17] = r11;                                  // movq %r11, -112(%rsp)
  r8 = !rdi & r8;                               // andnq %r8, %rdi, %r8
  r8 ^= rsi;                                    // xorq %rsi, %r8
  a[23] = r8;                                   // movq %r8, -80(%rsp)
  r15 ^= rdi;                                   // xorq %rdi, %r15
  a[5] = r15;                                   // movq %r15, -48(%rsp)
  rsi = !rsi & rdi;                             // andnq %rdi, %rsi, %rsi
  rsi ^= rbx;                                   // xorq %rbx, %rsi
  a[11] = rsi;                                  // movq %rsi, -64(%rsp)
  rsi = rbp;                                    // movq %rbp, %rsi
  rsi ^= a[2];                                  // xorq 8(%rsp), %rsi
  rdx ^= a[8];                                  // xorq (%rsp), %rdx
  rax ^= a[14];                                 // xorq -56(%rsp), %rax
  rdi = r14;                                    // movq %r14, %rdi
  rdi ^= a[15];                                 // xorq -72(%rsp), %rdi
  rcx ^= e[2];                                  // xorq 16(%rsp), %rcx
  rsi = #RORX_64(rsi, 2);                       // rorxq $2, %rsi, %rsi
  rdx = #RORX_64(rdx, 9);                       // rorxq $9, %rdx, %rdx
  rax = #RORX_64(rax, 25);                      // rorxq $25, %rax, %rax
  rdi = #RORX_64(rdi, 23);                      // rorxq $23, %rdi, %rdi
  rcx = #RORX_64(rcx, 62);                      // rorxq $62, %rcx, %rcx
  r9 = !rcx & rsi;                              // andnq %rsi, %rcx, %r9
  r9 ^= rdi;                                    // xorq %rdi, %r9
  a[15] = r9;                                   // movq %r9, -72(%rsp)
  r14 = !rax & rdi;                             // andnq %rdi, %rax, %r14
  r11 = !rdi & rcx;                             // andnq %rcx, %rdi, %r11
  r11 ^= rax;                                   // xorq %rax, %r11
  rax = !rdx & rax;                             // andnq %rax, %rdx, %rax
  rax ^= rsi;                                   // xorq %rsi, %rax
  rbp = rax;                                    // movq %rax, %rbp
  a[14] = rax;                                  // movq %rax, -56(%rsp)
  r14 ^= rdx;                                   // xorq %rdx, %r14
  e[2] = r14;                                   // movq %r14, 16(%rsp)
  rdi = !rsi & rdx;                             // andnq %rdx, %rsi, %rdi
  rdi ^= rcx;                                   // xorq %rcx, %rdi

  // ===================== round (E -> A), iota RC[c+1] ===================
  rax = r8;                                     // movq %r8, %rax
  rax ^= a[7];                                  // xorq -96(%rsp), %rax
  rsi = a[16];                                  // movq -128(%rsp), %rsi
  rsi ^= rbp;                                   // xorq %rbp, %rsi
  rsi ^= rax;                                   // xorq %rax, %rsi
  rbp = a[3];                                   // movq -40(%rsp), %rbp
  rax = rbp;                                    // movq %rbp, %rax
  rax ^= e[6];                                  // xorq 48(%rsp), %rax
  rdx = r15;                                    // movq %r15, %rdx
  rdx ^= e[4];                                  // xorq 32(%rsp), %rdx
  rdx ^= rax;                                   // xorq %rax, %rdx
  rax = e[5];                                   // movq 40(%rsp), %rax
  rax ^= a[17];                                 // xorq -112(%rsp), %rax
  r8 = r11;                                     // movq %r11, %r8
  r8 ^= e[8];                                   // xorq 64(%rsp), %r8
  r8 ^= rax;                                    // xorq %rax, %r8
  rbx = a[13];                                  // movq -104(%rsp), %rbx
  rbx ^= e[1];                                  // xorq -24(%rsp), %rbx
  rcx = r9;                                     // movq %r9, %rcx
  rcx ^= a[6];                                  // xorq -88(%rsp), %rcx
  rcx ^= rbx;                                   // xorq %rbx, %rcx
  rbx = e[7];                                   // movq 56(%rsp), %rbx
  rbx ^= rdi;                                   // xorq %rdi, %rbx
  rax = e[0];                                   // movq -32(%rsp), %rax
  rax ^= a[9];                                  // xorq -120(%rsp), %rax
  rax ^= rbx;                                   // xorq %rbx, %rax
  rsi ^= r12;                                   // xorq %r12, %rsi
  rdx ^= r14;                                   // xorq %r14, %rdx
  r8 ^= r13;                                    // xorq %r13, %r8
  rcx ^= r10;                                   // xorq %r10, %rcx
  r14 = a[11];                                  // movq -64(%rsp), %r14
  rax ^= r14;                                   // xorq %r14, %rax
  r15 = #RORX_64(rcx, 63);                      // rorxq $63, %rcx, %r15
  r15 ^= rdx;                                   // xorq %rdx, %r15
  rbx = #RORX_64(rdx, 63);                      // rorxq $63, %rdx, %rbx
  rbx ^= rax;                                   // xorq %rax, %rbx
  r9 = #RORX_64(rax, 63);                       // rorxq $63, %rax, %r9
  r9 ^= r8;                                     // xorq %r8, %r9
  r8 = #RORX_64(r8, 63);                        // rorxq $63, %r8, %r8
  r8 ^= rsi;                                    // xorq %rsi, %r8
  rdx = #RORX_64(rsi, 63);                      // rorxq $63, %rsi, %rdx
  rdx ^= rcx;                                   // xorq %rcx, %rdx
  r12 ^= rbx;                                   // xorq %rbx, %r12
  rbp ^= r8;                                    // xorq %r8, %rbp
  rax = #RORX_64(rbp, 20);                      // rorxq $20, %rbp, %rax
  r13 ^= r15;                                   // xorq %r15, %r13
  rcx = #RORX_64(r13, 21);                      // rorxq $21, %r13, %rcx
  r10 ^= r9;                                    // xorq %r9, %r10
  rsi = #RORX_64(r10, 43);                      // rorxq $43, %r10, %rsi
  rdi ^= rdx;                                   // xorq %rdx, %rdi
  rdi = #RORX_64(rdi, 50);                      // rorxq $50, %rdi, %rdi
  r10 = !rdi & r12;                             // andnq %r12, %rdi, %r10
  r10 ^= rsi;                                   // xorq %rsi, %r10
  a[3] = r10;                                   // movq %r10, -40(%rsp)
  r10 = !rcx & rsi;                             // andnq %rsi, %rcx, %r10
  rsi = !rsi & rdi;                             // andnq %rdi, %rsi, %rsi
  rsi ^= rcx;                                   // xorq %rcx, %rsi
  a[2] = rsi;                                   // movq %rsi, 8(%rsp)
  rbp = !rax & rcx;                             // andnq %rcx, %rax, %rbp
  rcx = e[3];                                   // movq 24(%rsp), %rcx   (counter reload)
  RC = KECCAK1600_RC;                            // leaq KeccakF_RoundConstants(%rip), %rsi
  rbp ^= RC[(int) rcx + 3];                      // xorq 24(%rsi,%rcx,8), %rbp
  rbp ^= r12;                                   // xorq %r12, %rbp
  e[9] = rbp;                                   // park idle rbp (a[0]) in dead e[9] -> frees 1 GP reg across round-2 tail
  r10 ^= rax;                                   // xorq %rax, %r10
  a[1] = r10;                                   // movq %r10, -16(%rsp)
  rax = !r12 & rax;                             // andnq %rax, %r12, %rax
  rax ^= rdi;                                   // xorq %rdi, %rax
  a[4] = rax;                                   // movq %rax, -8(%rsp)
  rax = a[6];                                   // movq -88(%rsp), %rax
  rax ^= r9;                                    // xorq %r9, %rax
  rax = #RORX_64(rax, 36);                      // rorxq $36, %rax, %rax
  rcx = a[9];                                   // movq -120(%rsp), %rcx
  rcx ^= rdx;                                   // xorq %rdx, %rcx
  rcx = #RORX_64(rcx, 44);                      // rorxq $44, %rcx, %rcx
  rsi = a[7];                                   // movq -96(%rsp), %rsi
  rsi ^= rbx;                                   // xorq %rbx, %rsi
  rsi = #RORX_64(rsi, 61);                      // rorxq $61, %rsi, %rsi
  rdi = a[5];                                   // movq -48(%rsp), %rdi
  rdi ^= r8;                                    // xorq %r8, %rdi
  rdi = #RORX_64(rdi, 19);                      // rorxq $19, %rdi, %rdi
  r11 ^= r15;                                   // xorq %r15, %r11
  r10 = #RORX_64(r11, 3);                       // rorxq $3, %r11, %r10
  r11 = !r10 & rax;                             // andnq %rax, %r10, %r11
  r11 ^= rdi;                                   // xorq %rdi, %r11
  a[8] = r11;                                   // movq %r11, (%rsp)
  r11 = !rsi & rdi;                             // andnq %rdi, %rsi, %r11
  rdi = !rdi & r10;                             // andnq %r10, %rdi, %rdi
  rdi ^= rsi;                                   // xorq %rsi, %rdi
  a[7] = rdi;                                   // movq %rdi, -96(%rsp)
  rsi = !rcx & rsi;                             // andnq %rsi, %rcx, %rsi
  rsi ^= rax;                                   // xorq %rax, %rsi
  a[5] = rsi;                                   // movq %rsi, -48(%rsp)
  r11 ^= rcx;                                   // xorq %rcx, %r11
  a[6] = r11;                                   // movq %r11, -88(%rsp)
  rax = !rax & rcx;                             // andnq %rcx, %rax, %rax
  rax ^= r10;                                   // xorq %r10, %rax
  a[9] = rax;                                   // movq %rax, -120(%rsp)
  rax = e[6];                                   // movq 48(%rsp), %rax
  rax ^= r8;                                    // xorq %r8, %rax
  rax = #RORX_64(rax, 63);                      // rorxq $63, %rax, %rax
  rcx = e[5];                                   // movq 40(%rsp), %rcx
  rcx ^= r15;                                   // xorq %r15, %rcx
  rcx = #RORX_64(rcx, 58);                      // rorxq $58, %rcx, %rcx
  rsi = a[13];                                  // movq -104(%rsp), %rsi
  rsi ^= r9;                                    // xorq %r9, %rsi
  rsi = #RORX_64(rsi, 39);                      // rorxq $39, %rsi, %rsi
  rdi = r14;                                    // movq %r14, %rdi
  rdi ^= rdx;                                   // xorq %rdx, %rdi
  rdi = #RORX_64(rdi, 56);                      // rorxq $56, %rdi, %rdi
  r10 = a[14];                                  // movq -56(%rsp), %r10
  r10 ^= rbx;                                   // xorq %rbx, %r10
  r10 = #RORX_64(r10, 46);                      // rorxq $46, %r10, %r10
  r11 = !r10 & rax;                             // andnq %rax, %r10, %r11
  r11 ^= rdi;                                   // xorq %rdi, %r11
  a[13] = r11;                                  // movq %r11, -104(%rsp)
  r11 = !rsi & rdi;                             // andnq %rdi, %rsi, %r11
  r13 = !rdi & r10;                             // andnq %r10, %rdi, %r13
  r13 ^= rsi;                                   // xorq %rsi, %r13
  rdi = !rcx & rsi;                             // andnq %rsi, %rcx, %rdi
  rdi ^= rax;                                   // xorq %rax, %rdi
  r11 ^= rcx;                                   // xorq %rcx, %r11
  a[11] = r11;                                  // movq %r11, -64(%rsp)
  rax = !rax & rcx;                             // andnq %rcx, %rax, %rax
  rax ^= r10;                                   // xorq %r10, %rax
  a[14] = rax;                                  // movq %rax, -56(%rsp)
  rax = e[7];                                   // movq 56(%rsp), %rax
  rax ^= rdx;                                   // xorq %rdx, %rax
  rax = #RORX_64(rax, 37);                      // rorxq $37, %rax, %rax
  rcx = a[16];                                  // movq -128(%rsp), %rcx
  rcx ^= rbx;                                   // xorq %rbx, %rcx
  rcx = #RORX_64(rcx, 28);                      // rorxq $28, %rcx, %rcx
  rsi = e[4];                                   // movq 32(%rsp), %rsi
  rsi ^= r8;                                    // xorq %r8, %rsi
  r11 = #RORX_64(rsi, 54);                      // rorxq $54, %rsi, %r11
  rsi = a[17];                                  // movq -112(%rsp), %rsi
  rsi ^= r15;                                   // xorq %r15, %rsi
  r14 = #RORX_64(rsi, 49);                      // rorxq $49, %rsi, %r14
  rsi = a[15];                                  // movq -72(%rsp), %rsi
  rsi ^= r9;                                    // xorq %r9, %rsi
  r12 = #RORX_64(rsi, 8);                       // rorxq $8, %rsi, %r12
  r10 = !r12 & rax;                             // andnq %rax, %r12, %r10
  r10 ^= r14;                                   // xorq %r14, %r10
  rsi = !r11 & r14;                             // andnq %r14, %r11, %rsi
  r14 = !r14 & r12;                             // andnq %r12, %r14, %r14
  r14 ^= r11;                                   // xorq %r11, %r14
  a[17] = r14;                                  // movq %r14, -112(%rsp)
  r11 = !rcx & r11;                             // andnq %r11, %rcx, %r11
  r11 ^= rax;                                   // xorq %rax, %r11
  a[15] = r11;                                  // movq %r11, -72(%rsp)
  rsi ^= rcx;                                   // xorq %rcx, %rsi
  a[16] = rsi;                                  // movq %rsi, -128(%rsp)
  r11 = !rax & rcx;                             // andnq %rcx, %rax, %r11
  r11 ^= r12;                                   // xorq %r12, %r11
  r15 ^= e[8];                                  // xorq 64(%rsp), %r15
  r9 ^= e[1];                                   // xorq -24(%rsp), %r9
  rdx ^= e[0];                                  // xorq -32(%rsp), %rdx
  rbx ^= a[23];                                 // xorq -80(%rsp), %rbx
  r8 ^= e[2];                                   // xorq 16(%rsp), %r8
  rax = #RORX_64(r15, 2);                       // rorxq $2, %r15, %rax
  rcx = #RORX_64(r9, 9);                        // rorxq $9, %r9, %rcx
  rdx = #RORX_64(rdx, 25);                      // rorxq $25, %rdx, %rdx
  r9 = #RORX_64(rbx, 23);                       // rorxq $23, %rbx, %r9
  r14 = #RORX_64(r8, 62);                       // rorxq $62, %r8, %r14
  r8 = !r14 & rax;                              // andnq %rax, %r14, %r8
  r8 ^= r9;                                     // xorq %r9, %r8
  a[23] = r8;                                   // movq %r8, -80(%rsp)
  rsi = !rdx & r9;                              // andnq %r9, %rdx, %rsi
  r15 = !r9 & r14;                              // andnq %r14, %r9, %r15
  r15 ^= rdx;                                   // xorq %rdx, %r15
  r8 = !rcx & rdx;                              // andnq %rdx, %rcx, %r8
  r8 ^= rax;                                    // xorq %rax, %r8
  rsi ^= rcx;                                   // xorq %rcx, %rsi
  rbx = !rax & rcx;                             // andnq %rcx, %rax, %rbx
  rbx ^= r14;                                   // xorq %r14, %rbx
  rcx = e[3];                                   // movq 24(%rsp), %rcx   (counter reload)
  rcx += 2;                                     // addq $2, %rcx
  rax = rcx;                                    // movq %rcx, %rax
  // cmpq $22, %rcx                             # loop condition rcx < 22
  // jb .LBB0_1                                 # branch back to loop header

  rbp = e[9];                                   // restore parked a[0]
  return rax, rbp, rdi, r13, r10, r11, r8, rsi, r15, rbx, a, e;
}


inline fn __rounds
( reg mut ptr u64[25] a
) -> reg ptr u64[25]
{
  stack u64[25] e;
  reg u64 rax, rbp, rdi, r13, r10, r11, r8, rsi, r15, rbx;


  rax = 0; rax -= 2; // counter starts at -2 (clang: movq $-2,%rax)
  rbp = a[0];
  rdi = a[10];
  r13 = a[12];
  r10 = a[18];
  r11 = a[19];
  r8 = a[20];
  rsi = a[21];
  r15 = a[22];
  rbx = a[24];

  while {
    rax, rbp, rdi, r13, r10, r11, r8, rsi, r15, rbx, a, e
    = keccakf1600_loop_body(rax, rbp, rdi, r13, r10, r11, r8, rsi, r15, rbx, a, e);
  } (rax < 22)

  a[0] = rbp;
  a[10] = rdi;
  a[12] = r13;
  a[18] = r10;
  a[19] = r11;
  a[20] = r8;
  a[21] = rsi;
  a[22] = r15;
  a[24] = rbx;

  return a;
}

export fn keccakf1600_refopt
( reg ptr u64[25] a
) -> reg ptr u64[25]
{
  a = __rounds(a);
  return a;
}