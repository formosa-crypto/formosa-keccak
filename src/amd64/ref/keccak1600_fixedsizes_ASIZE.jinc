/** IMPORTANT!
  this file shoould be in sync with its memory counterpart (keccak1600_fixedsizes.jinc)
*/
/**************************************************************************** 

   DEPENDENCIES:
   =============

param int KECCAK_FEATURES
param int KECCAK_PERMUTATION

require "keccakf1600.jinc"
require "keccak1600.jinc"

(e.g.
param int KECCAK_FEATURES
 = KECCAK_FEATURE_AVX2 | KECCAK_FEATURE_BMI | KECCAK_FEATURE_BMI2;
param int KECCAK_PERMUTATION = KECCAK_F1600_OPT;
)

*****************************************************************************/

from Keccak require "common/subreadwrite_ASIZE.jinc"

/*
   INCREMENTAL ARRAY ABSORB
   ========================
*/
#[safety =
   { requires = 0<= offset && 0<= _LEN && offset + _LEN <= _ASIZE && is_arr_init(buf,offset,_LEN) && is_arr_init(st,0,200)
   , requires = 0 <= _TRAILB && _TRAILB < 256 && 0<= AT && AT + _LEN + (_TRAILB != 0 ? 1 : 0) < 200
   , res = { final_st, final_AT, final_offset }
   , ensures = is_arr_init(final_st,0,200) && final_AT == AT + _LEN + (_TRAILB != 0 ? 1 : 0) && final_offset == offset + _LEN }
 ]
inline fn __addstate
( reg mut ptr u64[25] st
, inline int AT /* bytes (0 <= AT < 200) */
, reg const ptr u8[_ASIZE] buf
, reg ui64 offset
, inline int _LEN
, inline int _TRAILB
) -> reg ptr u64[25] /* st */
   , inline int      /* AT */
   , reg ui64        /* offset */
{
  inline bool HAS_AVX2;
  inline int i, DELTA, AT8;
  reg ui64 at;
  reg u64 w;
  reg u256 t256;
  reg u128 t128;

  HAS_AVX2 = __HAS_FEATURE(KECCAK_FEATURE_AVX2, KECCAK_FEATURES);

  DELTA = 0;

  // fill first word...
  if ( AT%8 != 0 ) {
    AT8 = 8*(AT/8);
    DELTA, _LEN, _TRAILB, AT, w = __a_ilen_read_upto8_at(buf, offset, DELTA, _LEN, _TRAILB, AT8, AT);
    st.[:u64 AT8] ^= w;
  }

  // at this point: AT == (AT/8)*8 || _LEN==0;

  // add complete words
  if ( HAS_AVX2 ) {
    for i = 0 to _LEN/32 {
      t256 = buf.[:u256 offset+DELTA];
      DELTA += 32;
      t256 ^= st.[:u256 AT+32*i];
      st.[:u256 AT+32*i] = t256;
    }
    if ( 16 <= _LEN % 32 ) {
      t128 = buf.[:u128 offset+DELTA];
      DELTA += 16;
      t128 ^= st.[:u128 AT+(_LEN/32)*32];
      st.[:u128 AT + (_LEN/32)*32] = t128;
    }
    if ( 8 <= _LEN % 16 ) {
      w = buf.[:u64 offset+DELTA];
      DELTA += 8;
      st.[:u64 AT+(_LEN/16)*16] ^= w;
    }
  } else {
    at = AT/8;
    offset += DELTA;
    DELTA = 0;
    while ( at < AT/8 + _LEN/8 ) {
      w = buf.[:u64 offset];
      offset += 8;
      st[at] ^= w;
      at += 1;
    }
  }

  // add last word...
  AT += 8*(_LEN/8);
  _LEN = _LEN%8;
  if ( 0 < _LEN || _TRAILB%256!= 0 ) {
    AT8 = AT;
    DELTA, _LEN, _TRAILB, AT, w = __a_ilen_read_upto8_at(buf, offset, DELTA, _LEN, _TRAILB, AT, AT);
    st.[:u64 AT8] ^= w;
  }
  offset += DELTA;

  return st, AT, offset;
}

#[safety =
   { requires = 0<_RATE8 && _RATE8 < 200 &&  0 <= _TRAILB && _TRAILB < 256 && 0<= AT && AT < _RATE8 &&
                is_arr_init(buf,0,_ASIZE) && is_arr_init(st,0,7*32)
   , ensures = is_arr_init(st,0,7*32) }
 ]
inline fn __absorb
( reg mut ptr u64[25] st
, inline int AT
, reg const ptr u8[_ASIZE] buf
, inline int _TRAILB /* closes state if !=0 (i.e. adds trailbyte and padding) */
, inline int _RATE8
) -> reg ptr u64[25] /* st */
   , inline int /* AT */
{
  reg ui64 offset, i;
  inline int ITERS, _LEN;

  offset = 0;
  _LEN = _ASIZE;  

  if ( AT+_LEN >= _RATE8 ) { // more than one block...
    st, _, offset = __addstate(st, AT, buf, offset, _RATE8-AT, 0);
    _LEN = _LEN - (_RATE8-AT);
    AT = 0;
    () = #spill(buf,offset);
    st = _keccakf1600_ref(st);
    () = #unspill(buf,offset);
    ITERS = _LEN/_RATE8;
    i = 0;
    while ( i < ITERS ) {
      st, _, offset = __addstate(st, 0, buf, offset, _RATE8, 0);
      () = #spill(buf,offset,i);
      st = _keccakf1600_ref(st);
      () = #unspill(buf,offset,i);
      i += 1;
    }
    _LEN = _LEN % _RATE8;
  }
  st, AT, _ = __addstate(st, AT, buf, offset, _LEN, _TRAILB);
  if (_TRAILB!=0) { st = __addratebit(st, _RATE8); }

  return st, AT;
}


/*
   ONE-SHOT (FIXED-SIZE) MEMORY SQUEEZE
   ====================================
*/
#[safety =
   { requires = 0<= offset && 0<= _LEN && offset + _LEN <= _ASIZE && is_arr_init(st,0,7*32) && _LEN <= 200 && is_arr_init(buf,0,offset)
   , res = { final_buf, final_offset }
   , ensures = final_offset == offset + _LEN 
   , ensures = is_arr_init(final_buf,0,offset + _LEN)}
 ]
inline fn __dumpstate
( reg mut ptr u8[_ASIZE] buf
, reg ui64 offset
, inline int _LEN
, reg const ptr u64[25] st
) -> reg ptr u8[_ASIZE] /* buf */
   , reg ui64 /* offset */
{ 
  inline bool HAS_AVX2;
  inline int j, DELTA;
  reg ui64 i;
  reg u64 t;
  reg u128 t128;
  reg u256 t256;

  HAS_AVX2 = __HAS_FEATURE(KECCAK_FEATURE_AVX2, KECCAK_FEATURES);

  DELTA = 0;
  if ( HAS_AVX2 ) {
    for j = 0 to _LEN/32 {
      t256 = st.[:u256 32*j];
      buf.[:u256 offset+DELTA] = t256;
      DELTA += 32;
    }
    if ( 16 <= _LEN%32 ) {
      t128 = st.[:u128 (_LEN/32)*32];
      buf.[:u128 offset+DELTA] = t128;
      DELTA += 16;
    }
    if ( 8 <= _LEN%16 ) {
      t = st.[:u64 (_LEN/16)*16];
      buf.[:u64 offset+DELTA] = t;
      DELTA += 8;
    }
  } else {
    i = 0;
    while (i < _LEN/8) {
      t = st[i];
      buf.[:u64 offset] = t;
      offset += 8;
      i += 1;
    }
  }
  if (0 < _LEN%8) {
    t = st[_LEN/8];
    buf, DELTA, _ = __a_ilen_write_upto8( buf, offset, DELTA, _LEN%8, t);
  }
  offset += DELTA;

  return buf, offset;
}

#[safety =
   { requires =  0< _RATE8 && _RATE8 < 200 && is_arr_init(st,0,7*32)
   , ensures = is_arr_init(st,0,32*7) 
   , ensures = is_arr_init(buf,0,_ASIZE)}
 ]
inline fn __squeeze
( reg mut ptr u64[25] st
, reg mut ptr u8[_ASIZE] buf
, inline int _RATE8
) -> reg ptr u64[25] /* st */
   , reg ptr u8[_ASIZE] /* buf */
{
  reg ui64 offset, i;

  offset = 0;
  i = 0;
  while (i < _ASIZE/_RATE8) {
    i += 1;
    () = #spill(buf,offset,i);
    st = _keccakf1600_ref(st);
    () = #unspill(buf,offset,i);
    buf, offset = __dumpstate(buf, offset, _RATE8, st);
  }
  if (0 < _ASIZE%_RATE8) {
    () = #spill(buf,offset);
    st = _keccakf1600_ref(st);
    () = #unspill(buf,offset);
    buf, offset = __dumpstate(buf, offset, _ASIZE%_RATE8, st);
  }

  return st, buf;
}

