from Keccak require "common/keccakf1600_generic.jinc"
from Keccak require "common/keccakf1600x4_generic.jinc"

inline fn __rol_4u64_rho56(reg u256 a) -> reg u256
{
	reg u256 r;

	r = #VPSHUFB_256(a, ROL56[0]);

	return r; 
}


inline fn __rol_4u64_rho8(reg u256 a) -> reg u256
{
	reg u256 r;

	r = #VPSHUFB_256(a, ROL8[0]);

	return r; 
}


inline fn __rol_4u64(reg u256 a, inline int o) -> reg u256
{
	reg u256 r;
	reg u256 t256;

	r = #VPSLL_4u64(a, o);
	t256 = #VPSRL_4u64(a, 64 - o);

	r |= t256;

	return r; 
}

param int avx2x4_ba=0;
param int avx2x4_be=1;
param int avx2x4_bi=2;
param int avx2x4_bo=3;
param int avx2x4_bu=4;
param int avx2x4_ga=5;
param int avx2x4_ge=6;
param int avx2x4_gi=7;
param int avx2x4_go=8;
param int avx2x4_gu=9;
param int avx2x4_ka=10;
param int avx2x4_ke=11;
param int avx2x4_ki=12;
param int avx2x4_ko=13;
param int avx2x4_ku=14;
param int avx2x4_ma=15;
param int avx2x4_me=16;
param int avx2x4_mi=17;
param int avx2x4_mo=18;
param int avx2x4_mu=19;
param int avx2x4_sa=20;
param int avx2x4_se=21;
param int avx2x4_si=22;
param int avx2x4_so=23;
param int avx2x4_su=24;

/*
u256[24] KeccakF1600RoundConstants = {
  0x0000000000000001000000000000000100000000000000010000000000000001,
    0x0000000000008082000000000000808200000000000080820000000000008082,
    0x800000000000808a800000000000808a800000000000808a800000000000808a,
    0x8000000080008000800000008000800080000000800080008000000080008000,
    0x000000000000808b000000000000808b000000000000808b000000000000808b,
    0x0000000080000001000000008000000100000000800000010000000080000001,
    0x8000000080008081800000008000808180000000800080818000000080008081,
    0x8000000000008009800000000000800980000000000080098000000000008009,
    0x000000000000008a000000000000008a000000000000008a000000000000008a,
    0x0000000000000088000000000000008800000000000000880000000000000088,
    0x0000000080008009000000008000800900000000800080090000000080008009,
    0x000000008000000a000000008000000a000000008000000a000000008000000a,
    0x000000008000808b000000008000808b000000008000808b000000008000808b,
    0x800000000000008b800000000000008b800000000000008b800000000000008b,
    0x8000000000008089800000000000808980000000000080898000000000008089,
    0x8000000000008003800000000000800380000000000080038000000000008003,
    0x8000000000008002800000000000800280000000000080028000000000008002,
    0x8000000000000080800000000000008080000000000000808000000000000080,
    0x000000000000800a000000000000800a000000000000800a000000000000800a,
    0x800000008000000a800000008000000a800000008000000a800000008000000a,
    0x8000000080008081800000008000808180000000800080818000000080008081,
    0x8000000000008080800000000000808080000000000080808000000000008080,
    0x0000000080000001000000008000000100000000800000010000000080000001,
    0x8000000080008008800000008000800880000000800080088000000080008008
    };
*/

inline fn __prepare_theta(reg ptr u256[25] A_4x) -> reg u256, reg u256, reg u256, reg u256, reg u256
{ 
    reg u256 Ca, Ce, Ci, Co, Cu;

    // Ca = XOR256(Aba, XOR256(Aga, XOR256(Aka, XOR256(Ama, Asa))));
    Ca = A_4x[avx2x4_sa];   //[20]
    Ca ^= A_4x[avx2x4_ma];  //[15]
    Ca ^=  A_4x[avx2x4_ka]; //[10]
    Ca ^=  A_4x[avx2x4_ga]; //[ 5]
    Ca ^=  A_4x[avx2x4_ba]; //[ 0]

    // Ce = XOR256(Abe, XOR256(Age, XOR256(Ake, XOR256(Ame, Ase))));
    Ce = A_4x[avx2x4_se];   //[21]
    Ce ^= A_4x[avx2x4_me];  //[16]
    Ce ^= A_4x[avx2x4_ke];  //[11]
    Ce ^= A_4x[avx2x4_ge];  //[ 6]
    Ce ^= A_4x[avx2x4_be];  //[ 1]

    // Ci = XOR256(Abi, XOR256(Agi, XOR256(Aki, XOR256(Ami, Asi))));
    Ci = A_4x[avx2x4_si];   //[22]
    Ci ^= A_4x[avx2x4_mi];  //[17]
    Ci ^= A_4x[avx2x4_ki];  //[12]
    Ci ^= A_4x[avx2x4_gi];  //[ 7]
    Ci ^= A_4x[avx2x4_bi];  //[ 2]

    // Co = XOR256(Abo, XOR256(Ago, XOR256(Ako, XOR256(Amo, Aso))));
    Co = A_4x[avx2x4_so];   //[23]
    Co ^= A_4x[avx2x4_mo];  //[18]
    Co ^= A_4x[avx2x4_ko];  //[13]
    Co ^= A_4x[avx2x4_go];  //[ 8]
    Co ^= A_4x[avx2x4_bo];  //[ 3]

    // Cu = XOR256(Abu, XOR256(Agu, XOR256(Aku, XOR256(Amu, Asu))));
    Cu = A_4x[avx2x4_su];   //[24]
    Cu ^= A_4x[avx2x4_mu];  //[19]
    Cu ^= A_4x[avx2x4_ku];  //[14]
    Cu ^= A_4x[avx2x4_gu];  //[ 9]
    Cu ^= A_4x[avx2x4_bu];  //[ 4]

    return Ca, Ce, Ci, Co, Cu;
}

inline fn __first(reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu) ->  reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Da, De, Di, Do, Du;
    reg u256 Ca1, Ce1, Ci1, Co1, Cu1;

    Ce1 = __rol_4u64(Ce, 1);
    Da = Cu ^ Ce1;

    Ci1 = __rol_4u64(Ci, 1);
    De = Ca ^ Ci1;

    Co1 = __rol_4u64(Co, 1);
    Di = Ce ^ Co1;

    Cu1 = __rol_4u64(Cu, 1);
    Do = Ci ^ Cu1;

    Ca1 = __rol_4u64(Ca, 1);
    Du = Co ^ Ca1;

    return Da, De, Di, Do, Du;
}


inline fn __second_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bba, Bbe, Bbi, Bbo, Bbu;
    reg u256 t256;

    t256 = A_4x[avx2x4_ba];
    t256 ^= Da;
    A_4x[avx2x4_ba] = t256;
    Bba = t256;

    t256 = A_4x[avx2x4_ge];
    t256 ^= De;
    A_4x[avx2x4_ge] = t256;
    Bbe = __rol_4u64(t256, 44);

    t256 = A_4x[avx2x4_ki];
    t256 ^= Di;
    A_4x[avx2x4_ki] = t256;
    Bbi = __rol_4u64(t256, 43);

    // E##ba = XOR256(Bba, ANDnu256(Bbe, Bbi)); XOReq256(E##ba, CONST256_64(KeccakF1600RoundConstants[i]));
    t256 = #VPANDN_256(Bbe, Bbi);
    t256 ^= Bba;
    t256 ^= rc_index; //KeccakF1600RoundConstants[index];
    E_4x[avx2x4_ba] = t256;

    Ca = t256;

    t256 = A_4x[avx2x4_mo];
    t256 ^= Do;
    A_4x[avx2x4_mo] = t256;
    Bbo = __rol_4u64(t256, 21);

    //  E##be = XOR256(Bbe, ANDnu256(Bbi, Bbo));
    t256 = #VPANDN_256(Bbi, Bbo);
    t256 ^= Bbe;
    E_4x[avx2x4_be] = t256;

    Ce = t256;

    t256 = A_4x[avx2x4_su];
    t256 ^= Du;
    A_4x[avx2x4_su] = t256;
    Bbu = __rol_4u64(t256, 14);

    // E##bi = XOR256(Bbi, ANDnu256(Bbo, Bbu)); 
    t256 = #VPANDN_256(Bbo, Bbu);
    t256 ^= Bbi;
    E_4x[avx2x4_bi] = t256;

    Ci = t256;

    // E##bo = XOR256(Bbo, ANDnu256(Bbu, Bba));
    t256 = #VPANDN_256(Bbu, Bba);
    t256 ^= Bbo;
    E_4x[avx2x4_bo] = t256; 
    
    Co = t256; 
    
    // E##bu = XOR256(Bbu, ANDnu256(Bba, Bbe));
    t256 = #VPANDN_256(Bba, Bbe);
    t256 ^= Bbu; 
    E_4x[avx2x4_bu] = t256;

    Cu = t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __third_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bga, Bge, Bgi, Bgo, Bgu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bo];
    t256 ^= Do;
    A_4x[avx2x4_bo] = t256;
    Bga = __rol_4u64(t256, 28);

    t256 = A_4x[avx2x4_gu];
    t256 ^= Du;
    A_4x[avx2x4_gu] = t256;
    Bge = __rol_4u64(t256, 20);

    t256 = A_4x[avx2x4_ka];
    t256 ^= Da;
    A_4x[avx2x4_ka] = t256;
    Bgi = __rol_4u64(t256, 3);

    // E##ga = XOR256(Bga, ANDnu256(Bge, Bgi))
    t256 = #VPANDN_256(Bge, Bgi);
    t256 ^= Bga;
    E_4x[avx2x4_ga] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_me];
    t256 ^= De;
    A_4x[avx2x4_me] = t256;
    Bgo = __rol_4u64(t256, 45);

    // E##ge = XOR256(Bge, ANDnu256(Bgi, Bgo))
    t256 = #VPANDN_256(Bgi, Bgo);
    t256 ^= Bge;
    E_4x[avx2x4_ge] = t256;

    Ce ^= t256;

    t256 = A_4x[avx2x4_si];
    t256 ^= Di;
    A_4x[avx2x4_si] = t256;
    Bgu = __rol_4u64(t256, 61);

    //  E##gi = XOR256(Bgi, ANDnu256(Bgo, Bgu))
    t256 = #VPANDN_256(Bgo, Bgu);
    t256 ^= Bgi;
    E_4x[avx2x4_gi] = t256;
    
    Ci ^= t256;

    // E##go = XOR256(Bgo, ANDnu256(Bgu, Bga));
    t256 = #VPANDN_256(Bgu, Bga);
    t256 ^= Bgo;
    E_4x[avx2x4_go] = t256;
    
    Co ^= t256;

    // E##gu = XOR256(Bgu, ANDnu256(Bga, Bge));
    t256 = #VPANDN_256(Bga, Bge);
    t256 ^= Bgu;
    E_4x[avx2x4_gu] = t256;
    
    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __fourth_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bka, Bke, Bki, Bko, Bku;
    reg u256 t256;

    t256 = A_4x[avx2x4_be];
    t256 ^= De;
    A_4x[avx2x4_be] = t256;
    Bka = __rol_4u64(t256, 1);

    t256 = A_4x[avx2x4_gi];
    t256 ^= Di;
    A_4x[avx2x4_gi] = t256;
    Bke = __rol_4u64(t256, 6);

    t256 = A_4x[avx2x4_ko];
    t256 ^= Do;
    A_4x[avx2x4_ko] = t256;
    Bki = __rol_4u64(t256, 25);

    // E##ka = XOR256(Bka, ANDnu256(Bke, Bki));
    t256 = #VPANDN_256(Bke, Bki);
    t256 ^= Bka;
    E_4x[avx2x4_ka] = t256;

    Ca ^= t256;
    
    t256 = A_4x[avx2x4_mu];
    t256 ^= Du;
    A_4x[avx2x4_mu] = t256;
    Bko = __rol_4u64_rho8(t256);

    // E##ke = XOR256(Bke, ANDnu256(Bki, Bko));
    t256 = #VPANDN_256(Bki, Bko);
    t256 ^= Bke;
    E_4x[avx2x4_ke] = t256;

    Ce ^= t256;
    
    t256 = A_4x[avx2x4_sa];
    t256 ^= Da;
    A_4x[avx2x4_sa] = t256;
    Bku = __rol_4u64(t256, 18);

    // E##ki = XOR256(Bki, ANDnu256(Bko, Bku))
    t256 = #VPANDN_256(Bko, Bku);
    t256 ^= Bki;
    E_4x[avx2x4_ki] = t256;

    Ci ^= t256;

    //  E##ko = XOR256(Bko, ANDnu256(Bku, Bka));
    t256 = #VPANDN_256(Bku, Bka);
    t256 ^= Bko;
    E_4x[avx2x4_ko] = t256;

    Co ^= t256;

    //  E##ku = XOR256(Bku, ANDnu256(Bka, Bke));
    t256 = #VPANDN_256(Bka, Bke);
    t256 ^= Bku;
    E_4x[avx2x4_ku] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __fifth_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bma, Bme, Bmi, Bmo, Bmu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bu];
    t256 ^= Du;
    A_4x[avx2x4_bu] = t256;
    Bma = __rol_4u64(t256, 27);

    t256 = A_4x[avx2x4_ga];
    t256 ^= Da;
    A_4x[avx2x4_ga] = t256;
    Bme = __rol_4u64(t256, 36);

    t256 = A_4x[avx2x4_ke];
    t256 ^= De;
    A_4x[avx2x4_ke] = t256;
    Bmi = __rol_4u64(t256, 10);

    // E##ma = XOR256(Bma, ANDnu256(Bme, Bmi));
    t256 = #VPANDN_256(Bme, Bmi);
    t256 ^= Bma;
    E_4x[avx2x4_ma] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_mi];
    t256 ^= Di;
    A_4x[avx2x4_mi] = t256;
    Bmo = __rol_4u64(t256, 15);

    // E##me = XOR256(Bme, ANDnu256(Bmi, Bmo));
    t256 = #VPANDN_256(Bmi, Bmo);
    t256 ^= Bme;
    E_4x[avx2x4_me] = t256;

    Ce ^= t256;

    t256 = A_4x[avx2x4_so];
    t256 ^= Do;
    A_4x[avx2x4_so] = t256;
    Bmu = __rol_4u64_rho56(t256);

    // E##mi = XOR256(Bmi, ANDnu256(Bmo, Bmu));
    t256 = #VPANDN_256(Bmo, Bmu);
    t256 ^= Bmi;
    E_4x[avx2x4_mi] = t256;

    Ci ^= t256;

    // E##mo = XOR256(Bmo, ANDnu256(Bmu, Bma));
    t256 = #VPANDN_256(Bmu, Bma);
    t256 ^= Bmo;
    E_4x[avx2x4_mo] = t256;

    Co ^= t256;

    // E##mu = XOR256(Bmu, ANDnu256(Bma, Bme));
    t256 = #VPANDN_256(Bma, Bme);
    t256 ^= Bmu;
    E_4x[avx2x4_mu] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __sixth_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bsa, Bse, Bsi, Bso, Bsu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bi];
    t256 ^= Di;
    A_4x[avx2x4_bi] = t256;
    Bsa = __rol_4u64(t256, 62);

    t256 = A_4x[avx2x4_go];
    t256 ^= Do;
    A_4x[avx2x4_go] = t256;
    Bse = __rol_4u64(t256, 55);

    t256 = A_4x[avx2x4_ku];
    t256 ^= Du;
    A_4x[avx2x4_ku] = t256;
    Bsi = __rol_4u64(t256, 39);

    // E##sa = XOR256(Bsa, ANDnu256(Bse, Bsi));
    t256 = #VPANDN_256(Bse, Bsi);
    t256 ^= Bsa;
    E_4x[avx2x4_sa] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_ma];
    t256 ^= Da;
    A_4x[avx2x4_ma] = t256;
    Bso = __rol_4u64(t256, 41);

    // E##se = XOR256(Bse, ANDnu256(Bsi, Bso))
    t256 = #VPANDN_256(Bsi, Bso);
    t256 ^= Bse;
    E_4x[avx2x4_se] = t256;  

    Ce ^= t256;

    t256 = A_4x[avx2x4_se];
    t256 ^= De;
    A_4x[avx2x4_se] = t256;
    Bsu = __rol_4u64(t256, 2);

    // E##si = XOR256(Bsi, ANDnu256(Bso, Bsu)); 
    t256 = #VPANDN_256(Bso, Bsu);
    t256 ^= Bsi;
    E_4x[avx2x4_si] = t256;

    Ci ^= t256;

    // E##so = XOR256(Bso, ANDnu256(Bsu, Bsa));
    t256 = #VPANDN_256(Bsu, Bsa);
    t256 ^= Bso;
    E_4x[avx2x4_so] = t256;

    Co ^= t256;

    // E##su = XOR256(Bsu, ANDnu256(Bsa, Bse));
    t256 = #VPANDN_256(Bsa, Bse);
    t256 ^= Bsu;
    E_4x[avx2x4_su] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __second_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bba, Bbe, Bbi, Bbo, Bbu;
    reg u256 t256;

    t256 = A_4x[avx2x4_ba];
    t256 ^= Da;
    A_4x[avx2x4_ba] = t256;
    Bba = t256;

    t256 = A_4x[avx2x4_ge];
    t256 ^= De;
    A_4x[avx2x4_ge] = t256;
    Bbe = __rol_4u64(t256, 44);

    t256 = A_4x[avx2x4_ki];
    t256 ^= Di;
    A_4x[avx2x4_ki] = t256;
    Bbi = __rol_4u64(t256, 43);

    // E##ba = XOR256(Bba, ANDnu256(Bbe, Bbi)); XOReq256(E##ba, CONST256_64(KeccakF1600RoundConstants[i]));
    t256 = #VPANDN_256(Bbe, Bbi);
    t256 ^= Bba;
    t256 ^= rc_index; //KeccakF1600RoundConstants[index];
    E_4x[avx2x4_ba] = t256;

    Ca = t256;

    t256 = A_4x[avx2x4_mo];
    t256 ^= Do;
    A_4x[avx2x4_mo] = t256;
    Bbo = __rol_4u64(t256, 21);

    //  E##be = XOR256(Bbe, ANDnu256(Bbi, Bbo));
    t256 = #VPANDN_256(Bbi, Bbo);
    t256 ^= Bbe;
    E_4x[avx2x4_be] = t256;

    Ce = t256;

    t256 = A_4x[avx2x4_su];
    t256 ^= Du;
    A_4x[avx2x4_su] = t256;
    Bbu = __rol_4u64(t256, 14);

    // E##bi = XOR256(Bbi, ANDnu256(Bbo, Bbu)); 
    t256 = #VPANDN_256(Bbo, Bbu);
    t256 ^= Bbi;
    E_4x[avx2x4_bi] = t256;

    Ci = t256;

    // E##bo = XOR256(Bbo, ANDnu256(Bbu, Bba));
    t256 = #VPANDN_256(Bbu, Bba);
    t256 ^= Bbo;
    E_4x[avx2x4_bo] = t256; 
    
    Co = t256; 
    
    // E##bu = XOR256(Bbu, ANDnu256(Bba, Bbe));
    t256 = #VPANDN_256(Bba, Bbe);
    t256 ^= Bbu; 
    E_4x[avx2x4_bu] = t256;

    Cu = t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __third_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bga, Bge, Bgi, Bgo, Bgu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bo];
    t256 ^= Do;
    A_4x[avx2x4_bo] = t256;
    Bga = __rol_4u64(t256, 28);

    t256 = A_4x[avx2x4_gu];
    t256 ^= Du;
    A_4x[avx2x4_gu] = t256;
    Bge = __rol_4u64(t256, 20);

    t256 = A_4x[avx2x4_ka];
    t256 ^= Da;
    A_4x[avx2x4_ka] = t256;
    Bgi = __rol_4u64(t256, 3);   

    // E##ga = XOR256(Bga, ANDnu256(Bge, Bgi))
    t256 = #VPANDN_256(Bge, Bgi);
    t256 ^= Bga;
    E_4x[avx2x4_ga] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_me];
    t256 ^= De;
    A_4x[avx2x4_me] = t256;
    Bgo = __rol_4u64(t256, 45);

    // E##ge = XOR256(Bge, ANDnu256(Bgi, Bgo))
    t256 = #VPANDN_256(Bgi, Bgo);
    t256 ^= Bge;
    E_4x[avx2x4_ge] = t256;

    Ce ^= t256;

    t256 = A_4x[avx2x4_si];
    t256 ^= Di;
    A_4x[avx2x4_si] = t256;
    Bgu = __rol_4u64(t256, 61);

    //  E##gi = XOR256(Bgi, ANDnu256(Bgo, Bgu))
    t256 = #VPANDN_256(Bgo, Bgu);
    t256 ^= Bgi;
    E_4x[avx2x4_gi] = t256;
    
    Ci ^= t256;

    // E##go = XOR256(Bgo, ANDnu256(Bgu, Bga));
    t256 = #VPANDN_256(Bgu, Bga);
    t256 ^= Bgo;
    E_4x[avx2x4_go] = t256;
    
    Co ^= t256;

    // E##gu = XOR256(Bgu, ANDnu256(Bga, Bge));
    t256 = #VPANDN_256(Bga, Bge);
    t256 ^= Bgu;
    E_4x[avx2x4_gu] = t256;
    
    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __fourth_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bka, Bke, Bki, Bko, Bku;
    reg u256 t256;

    t256 = A_4x[avx2x4_be];
    t256 ^= De;
    A_4x[avx2x4_be] = t256;
    Bka = __rol_4u64(t256, 1);

    t256 = A_4x[avx2x4_gi];
    t256 ^= Di;
    A_4x[avx2x4_gi] = t256;
    Bke = __rol_4u64(t256, 6);

    t256 = A_4x[avx2x4_ko];
    t256 ^= Do;
    A_4x[avx2x4_ko] = t256;
    Bki = __rol_4u64(t256, 25);

    // E##ka = XOR256(Bka, ANDnu256(Bke, Bki));
    t256 = #VPANDN_256(Bke, Bki);
    t256 ^= Bka;
    E_4x[avx2x4_ka] = t256;

    Ca ^= t256;
    
    t256 = A_4x[avx2x4_mu];
    t256 ^= Du;
    A_4x[avx2x4_mu] = t256;
    Bko = __rol_4u64_rho8(t256);

    // E##ke = XOR256(Bke, ANDnu256(Bki, Bko));
    t256 = #VPANDN_256(Bki, Bko);
    t256 ^= Bke;
    E_4x[avx2x4_ke] = t256;

    Ce ^= t256;
    
    t256 = A_4x[avx2x4_sa];
    t256 ^= Da;
    A_4x[avx2x4_sa] = t256;
    Bku = __rol_4u64(t256, 18);

    // E##ki = XOR256(Bki, ANDnu256(Bko, Bku))
    t256 = #VPANDN_256(Bko, Bku);
    t256 ^= Bki;
    E_4x[avx2x4_ki] = t256;

    Ci ^= t256;

    //  E##ko = XOR256(Bko, ANDnu256(Bku, Bka));
    t256 = #VPANDN_256(Bku, Bka);
    t256 ^= Bko;
    E_4x[avx2x4_ko] = t256;

    Co ^= t256;

    //  E##ku = XOR256(Bku, ANDnu256(Bka, Bke));
    t256 = #VPANDN_256(Bka, Bke);
    t256 ^= Bku;
    E_4x[avx2x4_ku] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __fifth_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bma, Bme, Bmi, Bmo, Bmu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bu];
    t256 ^= Du;
    A_4x[avx2x4_bu] = t256;
    Bma = __rol_4u64(t256, 27);

    t256 = A_4x[avx2x4_ga];
    t256 ^= Da;
    A_4x[avx2x4_ga] = t256;
    Bme = __rol_4u64(t256, 36);

    t256 = A_4x[avx2x4_ke];
    t256 ^= De;
    A_4x[avx2x4_ke] = t256;
    Bmi = __rol_4u64(t256, 10);

    // E##ma = XOR256(Bma, ANDnu256(Bme, Bmi));
    t256 = #VPANDN_256(Bme, Bmi);
    t256 ^= Bma;
    E_4x[avx2x4_ma] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_mi];
    t256 ^= Di;
    A_4x[avx2x4_mi] = t256;
    Bmo = __rol_4u64(t256, 15);

    // E##me = XOR256(Bme, ANDnu256(Bmi, Bmo));
    t256 = #VPANDN_256(Bmi, Bmo);
    t256 ^= Bme;
    E_4x[avx2x4_me] = t256;

    Ce ^= t256;

    t256 = A_4x[avx2x4_so];
    t256 ^= Do;
    A_4x[avx2x4_so] = t256;
    Bmu = __rol_4u64_rho56(t256);

    // E##mi = XOR256(Bmi, ANDnu256(Bmo, Bmu));
    t256 = #VPANDN_256(Bmo, Bmu);
    t256 ^= Bmi;
    E_4x[avx2x4_mi] = t256;

    Ci ^= t256;

    // E##mo = XOR256(Bmo, ANDnu256(Bmu, Bma));
    t256 = #VPANDN_256(Bmu, Bma);
    t256 ^= Bmo;
    E_4x[avx2x4_mo] = t256;

    Co ^= t256;

    // E##mu = XOR256(Bmu, ANDnu256(Bma, Bme));
    t256 = #VPANDN_256(Bma, Bme);
    t256 ^= Bmu;
    E_4x[avx2x4_mu] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __sixth_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{
    reg u256 Bsa, Bse, Bsi, Bso, Bsu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bi];
    t256 ^= Di;
    A_4x[avx2x4_bi] = t256;
    Bsa = __rol_4u64(t256, 62);

    t256 = A_4x[avx2x4_go];
    t256 ^= Do;
    A_4x[avx2x4_go] = t256;
    Bse = __rol_4u64(t256, 55);

    t256 = A_4x[avx2x4_ku];
    t256 ^= Du;
    A_4x[avx2x4_ku] = t256;
    Bsi = __rol_4u64(t256, 39);

    // E##sa = XOR256(Bsa, ANDnu256(Bse, Bsi));
    t256 = #VPANDN_256(Bse, Bsi);
    t256 ^= Bsa;
    E_4x[avx2x4_sa] = t256;

    Ca ^= t256;

    t256 = A_4x[avx2x4_ma];
    t256 ^= Da;
    A_4x[avx2x4_ma] = t256;
    Bso = __rol_4u64(t256, 41);

    // E##se = XOR256(Bse, ANDnu256(Bsi, Bso))
    t256 = #VPANDN_256(Bsi, Bso);
    t256 ^= Bse;
    E_4x[avx2x4_se] = t256;  

    Ce ^= t256;

    t256 = A_4x[avx2x4_se];
    t256 ^= De;
    A_4x[avx2x4_se] = t256;
    Bsu = __rol_4u64(t256, 2);

    // E##si = XOR256(Bsi, ANDnu256(Bso, Bsu)); 
    t256 = #VPANDN_256(Bso, Bsu);
    t256 ^= Bsi;
    E_4x[avx2x4_si] = t256;

    Ci ^= t256;

    // E##so = XOR256(Bso, ANDnu256(Bsu, Bsa));
    t256 = #VPANDN_256(Bsu, Bsa);
    t256 ^= Bso;
    E_4x[avx2x4_so] = t256;

    Co ^= t256;

    // E##su = XOR256(Bsu, ANDnu256(Bsa, Bse));
    t256 = #VPANDN_256(Bsa, Bse);
    t256 ^= Bsu;
    E_4x[avx2x4_su] = t256;

    Cu ^= t256;

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __second_last(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Bba, Bbe, Bbi, Bbo, Bbu;
    reg u256 t256;

    t256 = A_4x[avx2x4_ba];
    t256 ^= Da;
    A_4x[avx2x4_ba] = t256;
    Bba = t256;

    t256 = A_4x[avx2x4_ge];
    t256 ^= De;
    A_4x[avx2x4_ge] = t256;
    Bbe = __rol_4u64(t256, 44);

    t256 = A_4x[avx2x4_ki];
    t256 ^= Di;
    A_4x[avx2x4_ki] = t256;
    Bbi = __rol_4u64(t256, 43);

    // E##ba = XOR256(Bba, ANDnu256(Bbe, Bbi)); XOReq256(E##ba, CONST256_64(KeccakF1600RoundConstants[i]));
    t256 = #VPANDN_256(Bbe, Bbi);
    t256 ^= Bba;
    t256 ^= rc_index; //KeccakF1600RoundConstants[index];
    E_4x[avx2x4_ba] = t256;

    t256 = A_4x[avx2x4_mo];
    t256 ^= Do;
    A_4x[avx2x4_mo] = t256;
    Bbo = __rol_4u64(t256, 21);

    //  E##be = XOR256(Bbe, ANDnu256(Bbi, Bbo));
    t256 = #VPANDN_256(Bbi, Bbo);
    t256 ^= Bbe;
    E_4x[avx2x4_be] = t256;

    t256 = A_4x[avx2x4_su];
    t256 ^= Du;
    A_4x[avx2x4_su] = t256;
    Bbu = __rol_4u64(t256, 14);

    // E##bi = XOR256(Bbi, ANDnu256(Bbo, Bbu)); 
    t256 = #VPANDN_256(Bbo, Bbu);
    t256 ^= Bbi;
    E_4x[avx2x4_bi] = t256;

    // E##bo = XOR256(Bbo, ANDnu256(Bbu, Bba));
    t256 = #VPANDN_256(Bbu, Bba);
    t256 ^= Bbo;
    E_4x[avx2x4_bo] = t256;
    
    // E##bu = XOR256(Bbu, ANDnu256(Bba, Bbe));
    t256 = #VPANDN_256(Bba, Bbe);
    t256 ^= Bbu; 
    E_4x[avx2x4_bu] = t256;

    return A_4x, E_4x;
}

inline fn __third_last(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Bga, Bge, Bgi, Bgo, Bgu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bo];
    t256 ^= Do;
    A_4x[avx2x4_bo] = t256;
    Bga = __rol_4u64(t256, 28);

    t256 = A_4x[avx2x4_gu];
    t256 ^= Du;
    A_4x[avx2x4_gu] = t256;
    Bge = __rol_4u64(t256, 20);

    t256 = A_4x[avx2x4_ka];
    t256 ^= Da;
    A_4x[avx2x4_ka] = t256;
    Bgi = __rol_4u64(t256, 3);   

    // E##ga = XOR256(Bga, ANDnu256(Bge, Bgi))
    t256 = #VPANDN_256(Bge, Bgi);
    t256 ^= Bga;
    E_4x[avx2x4_ga] = t256;

    t256 = A_4x[avx2x4_me];
    t256 ^= De;
    A_4x[avx2x4_me] = t256;
    Bgo = __rol_4u64(t256, 45);

    // E##ge = XOR256(Bge, ANDnu256(Bgi, Bgo))
    t256 = #VPANDN_256(Bgi, Bgo);
    t256 ^= Bge;
    E_4x[avx2x4_ge] = t256;

    t256 = A_4x[avx2x4_si];
    t256 ^= Di;
    A_4x[avx2x4_si] = t256;
    Bgu = __rol_4u64(t256, 61);

    //  E##gi = XOR256(Bgi, ANDnu256(Bgo, Bgu))
    t256 = #VPANDN_256(Bgo, Bgu);
    t256 ^= Bgi;
    E_4x[avx2x4_gi] = t256;

    // E##go = XOR256(Bgo, ANDnu256(Bgu, Bga));
    t256 = #VPANDN_256(Bgu, Bga);
    t256 ^= Bgo;
    E_4x[avx2x4_go] = t256;

    // E##gu = XOR256(Bgu, ANDnu256(Bga, Bge));
    t256 = #VPANDN_256(Bga, Bge);
    t256 ^= Bgu;
    E_4x[avx2x4_gu] = t256;

    return A_4x, E_4x;
}

inline fn __fourth_last(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Bka, Bke, Bki, Bko, Bku;
    reg u256 t256;

    t256 = A_4x[avx2x4_be];
    t256 ^= De;
    A_4x[avx2x4_be] = t256;
    Bka = __rol_4u64(t256, 1);

    t256 = A_4x[avx2x4_gi];
    t256 ^= Di;
    A_4x[avx2x4_gi] = t256;
    Bke = __rol_4u64(t256, 6);

    t256 = A_4x[avx2x4_ko];
    t256 ^= Do;
    A_4x[avx2x4_ko] = t256;
    Bki = __rol_4u64(t256, 25);

    // E##ka = XOR256(Bka, ANDnu256(Bke, Bki));
    t256 = #VPANDN_256(Bke, Bki);
    t256 ^= Bka;
    E_4x[avx2x4_ka] = t256;
    
    t256 = A_4x[avx2x4_mu];
    t256 ^= Du;
    A_4x[avx2x4_mu] = t256;
    Bko = __rol_4u64_rho8(t256);

    // E##ke = XOR256(Bke, ANDnu256(Bki, Bko));
    t256 = #VPANDN_256(Bki, Bko);
    t256 ^= Bke;
    E_4x[avx2x4_ke] = t256;
    
    t256 = A_4x[avx2x4_sa];
    t256 ^= Da;
    A_4x[avx2x4_sa] = t256;
    Bku = __rol_4u64(t256, 18);

    // E##ki = XOR256(Bki, ANDnu256(Bko, Bku))
    t256 = #VPANDN_256(Bko, Bku);
    t256 ^= Bki;
    E_4x[avx2x4_ki] = t256;

    //  E##ko = XOR256(Bko, ANDnu256(Bku, Bka));
    t256 = #VPANDN_256(Bku, Bka);
    t256 ^= Bko;
    E_4x[avx2x4_ko] = t256;

    //  E##ku = XOR256(Bku, ANDnu256(Bka, Bke));
    t256 = #VPANDN_256(Bka, Bke);
    t256 ^= Bku;
    E_4x[avx2x4_ku] = t256;

    return A_4x, E_4x;
}

inline fn __fifth_last(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Bma, Bme, Bmi, Bmo, Bmu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bu];
    t256 ^= Du;
    A_4x[avx2x4_bu] = t256;
    Bma = __rol_4u64(t256, 27);

    t256 = A_4x[avx2x4_ga];
    t256 ^= Da;
    A_4x[avx2x4_ga] = t256;
    Bme = __rol_4u64(t256, 36);

    t256 = A_4x[avx2x4_ke];
    t256 ^= De;
    A_4x[avx2x4_ke] = t256;
    Bmi = __rol_4u64(t256, 10);

    // E##ma = XOR256(Bma, ANDnu256(Bme, Bmi));
    t256 = #VPANDN_256(Bme, Bmi);
    t256 ^= Bma;
    E_4x[avx2x4_ma] = t256;

    t256 = A_4x[avx2x4_mi];
    t256 ^= Di;
    A_4x[avx2x4_mi] = t256;
    Bmo = __rol_4u64(t256, 15);

    // E##me = XOR256(Bme, ANDnu256(Bmi, Bmo));
    t256 = #VPANDN_256(Bmi, Bmo);
    t256 ^= Bme;
    E_4x[avx2x4_me] = t256;

    t256 = A_4x[avx2x4_so];
    t256 ^= Do;
    A_4x[avx2x4_so] = t256;
    Bmu = __rol_4u64_rho56(t256);

    // E##mi = XOR256(Bmi, ANDnu256(Bmo, Bmu));
    t256 = #VPANDN_256(Bmo, Bmu);
    t256 ^= Bmi;
    E_4x[avx2x4_mi] = t256;

    // E##mo = XOR256(Bmo, ANDnu256(Bmu, Bma));
    t256 = #VPANDN_256(Bmu, Bma);
    t256 ^= Bmo;
    E_4x[avx2x4_mo] = t256;

    // E##mu = XOR256(Bmu, ANDnu256(Bma, Bme));
    t256 = #VPANDN_256(Bma, Bme);
    t256 ^= Bmu;
    E_4x[avx2x4_mu] = t256;

    return A_4x, E_4x;
}

inline fn __sixth_last(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x,
reg u256 Da, reg u256 De, reg u256 Di, reg u256 Do, reg u256 Du) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Bsa, Bse, Bsi, Bso, Bsu;
    reg u256 t256;

    t256 = A_4x[avx2x4_bi];
    t256 ^= Di;
    A_4x[avx2x4_bi] = t256;
    Bsa = __rol_4u64(t256, 62);

    t256 = A_4x[avx2x4_go];
    t256 ^= Do;
    A_4x[avx2x4_go] = t256;
    Bse = __rol_4u64(t256, 55);

    t256 = A_4x[avx2x4_ku];
    t256 ^= Du;
    A_4x[avx2x4_ku] = t256;
    Bsi = __rol_4u64(t256, 39);

    // E##sa = XOR256(Bsa, ANDnu256(Bse, Bsi));
    t256 = #VPANDN_256(Bse, Bsi);
    t256 ^= Bsa;
    E_4x[avx2x4_sa] = t256;

    t256 = A_4x[avx2x4_ma];
    t256 ^= Da;
    A_4x[avx2x4_ma] = t256;
    Bso = __rol_4u64(t256, 41);

    // E##se = XOR256(Bse, ANDnu256(Bsi, Bso))
    t256 = #VPANDN_256(Bsi, Bso);
    t256 ^= Bse;
    E_4x[avx2x4_se] = t256;

    t256 = A_4x[avx2x4_se];
    t256 ^= De;
    A_4x[avx2x4_se] = t256;
    Bsu = __rol_4u64(t256, 2);

    // E##si = XOR256(Bsi, ANDnu256(Bso, Bsu)); 
    t256 = #VPANDN_256(Bso, Bsu);
    t256 ^= Bsi;
    E_4x[avx2x4_si] = t256;

    // E##so = XOR256(Bso, ANDnu256(Bsu, Bsa));
    t256 = #VPANDN_256(Bsu, Bsa);
    t256 ^= Bso;
    E_4x[avx2x4_so] = t256;

    // E##su = XOR256(Bsu, ANDnu256(Bsa, Bse));
    t256 = #VPANDN_256(Bsa, Bse);
    t256 ^= Bsu;
    E_4x[avx2x4_su] = t256;

    return A_4x, E_4x;
}

fn _theta_rho_pi_chi_iota_prepare_theta_even(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{   
    reg u256 Da, De, Di, Do, Du;

    Da, De, Di, Do, Du = __first(Ca, Ce, Ci, Co, Cu);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __second_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __third_even(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);
  
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __fourth_even(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __fifth_even(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __sixth_even(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

fn _theta_rho_pi_chi_iota_prepare_theta_odd(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu) 
-> reg ptr u256[25], reg ptr u256[25], reg u256, reg u256, reg u256, reg u256, reg u256
{   
    reg u256 Da, De, Di, Do, Du;

    Da, De, Di, Do, Du = __first(Ca, Ce, Ci, Co, Cu);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __second_odd(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __third_odd(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);
  
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __fourth_odd(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __fifth_odd(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = __sixth_odd(A_4x, E_4x, Ca, Ce, Ci, Co, Cu, Da, De, Di, Do, Du);

    return A_4x, E_4x, Ca, Ce, Ci, Co, Cu;
}

inline fn __theta_rho_pi_chi_iota(
reg ptr u256[25] A_4x, reg ptr u256[25] E_4x, reg u256 rc_index,
reg u256 Ca, reg u256 Ce, reg u256 Ci, reg u256 Co, reg u256 Cu) 
-> reg ptr u256[25], reg ptr u256[25]
{
    reg u256 Da, De, Di, Do, Du;

    Da, De, Di, Do, Du = __first(Ca, Ce, Ci, Co, Cu);

    A_4x, E_4x = __second_last(A_4x, E_4x, rc_index, Da, De, Di, Do, Du);

    A_4x, E_4x = __third_last(A_4x, E_4x, Da, De, Di, Do, Du);

    A_4x, E_4x = __fourth_last(A_4x, E_4x, Da, De, Di, Do, Du);

    A_4x, E_4x  = __fifth_last(A_4x, E_4x, Da, De, Di, Do, Du);
 
    A_4x, E_4x  = __sixth_last(A_4x, E_4x, Da, De, Di, Do, Du);

    return A_4x, E_4x;
}

inline fn __keccakf1600_avx2x4_alt
( reg ptr u256[25] A_4x
) -> reg ptr u256[25]
{
    reg ptr u64[24] RC;
    reg u256 Ca, Ce, Ci, Co, Cu, rc_index;
    stack u256[25] E_4x;

    RC = KECCAK1600_RC;

    /** Rounds24 **/
    Ca, Ce, Ci, Co, Cu = __prepare_theta(A_4x);
    rc_index = #VPBROADCAST_4u64(RC[0]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[1]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[2]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu); 
    rc_index = #VPBROADCAST_4u64(RC[3]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[4]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[5]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[6]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[7]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[8]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[9]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[10]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[11]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[12]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[13]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[14]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[15]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[16]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[17]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[18]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[19]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[20]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[21]);
    E_4x, A_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_odd(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[22]);
    A_4x, E_4x, Ca, Ce, Ci, Co, Cu = _theta_rho_pi_chi_iota_prepare_theta_even(A_4x, E_4x, rc_index, Ca, Ce, Ci, Co, Cu);
    rc_index = #VPBROADCAST_4u64(RC[23]);
    E_4x, A_4x = __theta_rho_pi_chi_iota(E_4x, A_4x, rc_index, Ca, Ce, Ci, Co, Cu);

    return A_4x;
}

fn _keccakf1600_avx2x4_alt
( reg ptr u256[25] a
) -> reg ptr u256[25]
{
  a = __keccakf1600_avx2x4_alt(a);
  return a;
}


