/**************************************************************************** 

   DEPENDENCIES:
   =============

param int KECCAK_PERMUTATION

(e.g.
param int KECCAK_PERMUTATION = KECCAK_F1600x4_REF;
)

*****************************************************************************/

from Keccak require "common/keccakf1600_generic.jinc"

require "keccakf1600x4_ref.jinc"
require "keccakf1600x4_alt.jinc"
require "keccakf1600x4_nat.jinc"

type keccakx4_state = u256[25];

/**
 * Select intended KeccalF[1600]x4 permutation:
 */
inline fn _keccakf1600_avx2x4
( reg ptr u256[25] a
) -> reg ptr u256[25]
{
  inline int KECCAK_F;
  KECCAK_F = __KECCAK_F(KECCAK_PERMUTATION);

  if (KECCAK_F == KECCAK_F1600x4_ALT) {
    a = _keccakf1600_avx2x4_alt(a);
  } else if (KECCAK_F == KECCAK_F1600x4_NAT) {
    a = _keccakf1600_avx2x4_nat(a);
  } else {
    a = _keccakf1600_avx2x4_ref(a);
  }
  return a;
}

inline fn _keccakf1600_avx2x4_
( reg ptr u256[25] a
) -> reg ptr u256[25]
{
  a = a;
  a = _keccakf1600_avx2x4(a);
  a = a;
  return a;
}


