  y2 = y2 | y5; // vpor %ymm5, %ymm2, %ymm2
  y5 = #VPSRL_4u64(y1, (128u) 0x9); // vpsrlq $0x9, %ymm1, %ymm5         // 9
  y1 = #VPSLL_4u64(y1, (128u) 0x37); // vpsllq $0x37, %ymm1, %ymm1        // 55
  y4 = #VPSLL_4u64(y4, (128u) 0x2); // vpsllq $0x2, %ymm4, %ymm4         // 2
  y1 = y5 | y1; // vpor %ymm1, %ymm5, %ymm1
  y5 = #VPSRL_4u64(y0, (128u) 0x19); // vpsrlq $0x19, %ymm0, %ymm5        // 25
  y4 = y6 | y4; // vpor %ymm4, %ymm6, %ymm4
  y0 = #VPSLL_4u64(y0, (128u) 0x27); // vpsllq $0x27, %ymm0, %ymm0        // 39
  y5 = y5 | y0; // vpor %ymm0, %ymm5, %ymm5
  y0 = !y1 & y5; //#VPANDN_256(y1, y5); // vpandn %ymm5, %ymm1, %ymm0
  y0 = y0 ^ y2; // vpxor %ymm2, %ymm0, %ymm0
  st[i14] = y0; // vmovdqu %ymm0, 0x1c0(%rsp)        // 448 [14]
  y0 = #VPSRL_4u64(y3, (128u) 0x17); // vpsrlq $0x17, %ymm3, %ymm0        // 23
  y3 = #VPSLL_4u64(y3, (128u) 0x29); // vpsllq $0x29, %ymm3, %ymm3        // 41
  y0 = y0 | y3; // vpor %ymm3, %ymm0, %ymm0
  y7 = !y0 & y4; //#VPANDN_256(y0, y4); // vpandn %ymm4, %ymm0, %ymm7
  y3 = !y5 & y0; //#VPANDN_256(y5, y0); // vpandn %ymm0, %ymm5, %ymm3
  y7 = y7 ^ y5; // vpxor %ymm5, %ymm7, %ymm7
  y5 = !y4 & y2; //#VPANDN_256(y4, y2); // vpandn %ymm2, %ymm4, %ymm5
  y2 = !y2 & y1; //#VPANDN_256(y2, y1); // vpandn %ymm1, %ymm2, %ymm2
  y5 = y5 ^ y0; // vpxor %ymm0, %ymm5, %ymm5
  y3 = y3 ^ y1; // vpxor %ymm1, %ymm3, %ymm3
  y2 = y2 ^ y4; // vpxor %ymm4, %ymm2, %ymm2
  st[i15] = y5; // vmovdqu %ymm5, 0x1e0(%rsp)        // 480 [15]

  return st, y10, y14, y8, y15, y9, y13, y3, y7, y2;
}

inline fn __regs_fetch
( reg const ptr u256[25] st
) -> reg u256, reg u256, reg u256, reg u256, reg u256
   , reg u256, reg u256, reg u256, reg u256
{
  reg u256 y10, y14, y8, y15, y9, y13, y3, y7, y2;
  // st[0..6] + YMM10 + YMM14 + st[9,10] + YMM8 + YMM15 + st[13,14] + YMM9 + st[16,17] + YMM13 + st[19,20] + YMM3 + YMM7 + st[23] + YMM2
  y10=st[7]; y14=st[8];
  y8=st[11]; y15=st[12];
  y9=st[15];
  y13=st[18];
  y3=st[21]; y7=st[22];
  y2=st[24];
  return y10, y14, y8, y15, y9, y13, y3, y7, y2;
}

inline fn __regs_unfetch
( reg mut ptr u256[25] st
, reg u256 y10 y14 y8 y15 y9 y13 y3 y7 y2
) -> reg ptr u256[25]
{
  st[7]=y10; st[8]=y14;
  st[11]=y8; st[12]=y15;
  st[15]=y9;
  st[18]=y13;
  st[21]=y3; st[22]=y7;
  st[24]=y2;

  return st;
}

/*
export fn test_keccakf1600x4_native
( reg mut ptr u256[25] st
, reg u64 c
) -> reg ptr u256[25]
{
  reg ptr u256[1] rol8, rol56;
  reg ptr u64[24] rc;
  reg u256 y10, y14, y8, y15, y9, y13, y3, y7, y2;

  y10, y14, y8, y15, y9, y13, y3, y7, y2 = __regs_fetch(st);

  rol8 = ROL8;
  rol56 = ROL56;
  rc = KECCAK1600_RC;
  st, y10, y14, y8, y15, y9, y13, y3, y7, y2
   = __f1600_loopbody_native(st, rol8, rol56, rc, (64ui) c, y10, y14, y8, y15, y9, y13, y3, y7, y2);
  st = __regs_unfetch(st, y10, y14, y8, y15, y9, y13, y3, y7, y2);

  return st;
}
*/

inline fn __keccakf1600_avx2x4_native
( reg mut ptr u256[25] st
) -> reg ptr u256[25]
{
  reg ui64 i;
  reg ptr u256[1] rol8, rol56;
  reg ptr u64[24] rc;
  reg u256 y10, y14, y8, y15, y9, y13, y3, y7, y2;

  y10, y14, y8, y15, y9, y13, y3, y7, y2 = __regs_fetch(st);

  rol8 = ROL8;
  rol56 = ROL56;
  rc = KECCAK1600_RC;
  i = 0;
  while {
    st, y10, y14, y8, y15, y9, y13, y3, y7, y2
     = __f1600_loopbody_native(st, rol8, rol56, rc, i, y10, y14, y8, y15, y9, y13, y3, y7, y2);
    i += 1;
  } (i < 24)
  
  st = __regs_unfetch(st, y10, y14, y8, y15, y9, y13, y3, y7, y2);

  return st;
}

