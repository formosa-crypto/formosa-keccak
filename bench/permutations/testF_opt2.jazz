from Keccak require "ref/select_bmi1.jinc"
from Keccak require "ref/keccakf1600.jinc"
from Keccak require "ref/keccakf1600_ref_opt.jinc"
from Keccak require "ref/keccakf1600_ref_opt2.jinc"

export fn testF_bmi1(reg mut ptr u64[25] st) -> reg ptr u64[25] {
  st = __keccakf1600_ref(st);
  return st;
}
export fn testF_ref_opt(reg mut ptr u64[25] st) -> reg ptr u64[25] {
  st = __keccakf1600_ref_opt(st);
  return st;
}
export fn testF_ref_opt2(reg mut ptr u64[25] st) -> reg ptr u64[25] {
  st = __keccakf1600_ref_opt2(st);
  return st;
}
