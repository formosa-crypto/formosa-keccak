from Keccak require "avx2/keccakf1600.jinc"
from Keccak require "avx2/keccakf1600x4.jinc"

from Keccak require "avx2/keccakf1600x4_orig.jinc"
from Keccak require "avx2/keccakf1600x4_alt.jinc"
from Keccak require "avx2/keccakf1600x4_native.jinc"

export fn testF_avx2
( reg mut ptr u256[7] st
) -> reg ptr u256[7]
{
 reg u256[7] regs;
 inline int i;
 for i = 0 to 7 {
  regs[i] = st[i];
 }
 regs = __keccakf1600_avx2(regs);
 for i = 0 to 7 {
  st[i] = regs[i];
 }
 return st;
}

export fn testF_avx2x4_orig
( reg mut ptr u256[25] st
) -> reg ptr u256[25]
{
 st = __keccakf1600_avx2x4_orig(st);
 return st;
}

export fn testF_avx2x4_alt
( reg mut ptr u256[25] st
) -> reg ptr u256[25]
{
 st = __keccakf1600_avx2x4_alt(st);
 return st;
}

export fn testF_avx2x4_native
( reg mut ptr u256[25] st
) -> reg ptr u256[25]
{
 st = __keccakf1600_avx2x4_native(st);
 return st;
}

